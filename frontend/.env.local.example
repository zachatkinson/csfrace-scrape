# =============================================================================
# FRONTEND - LOCAL SINGLE-USER CONFIGURATION
# =============================================================================
# This configuration matches .env.windows.example in the backend
# Use this for Windows/local deployments without OAuth
#
# SETUP:
# 1. Copy this file:  cp .env.local.example .env
# 2. Backend should have SKIP_AUTH_FOR_DEVELOPMENT=true in its .env
# =============================================================================

# =============================================================================
# API CONFIGURATION
# =============================================================================
PUBLIC_API_BASE_URL=http://localhost
SERVER_API_BASE_URL=http://localhost
PUBLIC_API_TIMEOUT=30000

# =============================================================================
# AUTHENTICATION (DISABLED for single-user local use)
# =============================================================================
# Disable OAuth login buttons in the UI
PUBLIC_ENABLE_OAUTH=false

# Disable WebAuthn/Passkeys in the UI
PUBLIC_ENABLE_WEBAUTHN=false

# =============================================================================
# FEATURE FLAGS
# =============================================================================
PUBLIC_ENABLE_BATCH_PROCESSING=true
PUBLIC_MAX_CONCURRENT_JOBS=5

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
PUBLIC_DEBUG_MODE=false
PUBLIC_ENABLE_PERFORMANCE_MONITORING=true
PUBLIC_LOG_LEVEL=info
PUBLIC_FRONTEND_PORT=3000
PUBLIC_THEME=light
PUBLIC_MONITORING_ENABLED=true

# =============================================================================
# NOTES:
# =============================================================================
# - When PUBLIC_ENABLE_OAUTH=false, login UI will be hidden
# - All jobs will be associated with the default "local-user"
# - No authentication required - direct access to scraping features
# =============================================================================
