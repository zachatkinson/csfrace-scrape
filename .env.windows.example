# =============================================================================
# WINDOWS LOCAL SINGLE-USER CONFIGURATION
# =============================================================================
# This configuration is optimized for Windows users who want to run the app
# locally for personal use WITHOUT setting up OAuth providers.
#
# QUICK START:
# 1. Copy this file:  cp .env.windows.example .env
# 2. Start services:  docker compose -f docker-compose.dev.yml up -d
# 3. Open browser:    http://localhost
# 4. Start scraping!  No login required
# =============================================================================

# =============================================================================
# AUTHENTICATION (SKIP for single-user local use)
# =============================================================================
# Skip authentication for single-user local deployments
# This creates a default "local-user" that owns all jobs
# ⚠️  DO NOT set this to true in production deployments!
SKIP_AUTH_FOR_DEVELOPMENT=true

# No OAuth credentials needed when SKIP_AUTH is enabled!
# (These can be left empty)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# =============================================================================
# CORE SETTINGS
# =============================================================================
ENVIRONMENT=development
SECRET_KEY=dev-secret-key-for-local-use-only

# =============================================================================
# DATABASE SETTINGS (Development defaults)
# =============================================================================
POSTGRES_DB=csfrace_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev-password

# =============================================================================
# API URLS (Development defaults - use HTTP for local)
# =============================================================================
OAUTH_REDIRECT_URI_BASE=http://localhost
WEBAUTHN_ORIGIN=http://localhost
WEBAUTHN_RP_ID=localhost

# =============================================================================
# PORTS (Defaults work for most users)
# =============================================================================
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# =============================================================================
# ADVANCED SETTINGS (Optional - defaults are fine)
# =============================================================================
# SCRAPER_CONCURRENT_REQUESTS=10
# SCRAPER_REQUEST_TIMEOUT=30
# ACCESS_TOKEN_EXPIRE_MINUTES=720

# =============================================================================
# NOTES FOR WINDOWS USERS:
# =============================================================================
# - Use docker-compose.dev.yml (NOT docker-compose.yml)
# - Commands:
#     Start:   docker compose -f docker-compose.dev.yml up -d
#     Stop:    docker compose -f docker-compose.dev.yml down
#     Logs:    docker compose -f docker-compose.dev.yml logs -f
#     Rebuild: docker compose -f docker-compose.dev.yml build --no-cache
# =============================================================================
