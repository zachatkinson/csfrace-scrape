# CSFrace Scrape - Environment Configuration Template
# Copy this file to .env and customize for your environment

#==============================================================================
# GLOBAL CONFIGURATION
#==============================================================================

# Project settings
COMPOSE_PROJECT_NAME=csfrace-scrape
ENVIRONMENT=development  # development|staging|production

# Networking
DOCKER_NETWORK=csfrace-network

#==============================================================================
# BACKEND CONFIGURATION (Python/FastAPI)
#==============================================================================

# Server settings
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
BACKEND_WORKERS=1

# Scraping configuration
SCRAPER_CONCURRENT_REQUESTS=10
SCRAPER_REQUEST_TIMEOUT=30
SCRAPER_MAX_RETRIES=3
SCRAPER_DELAY_BETWEEN_REQUESTS=1.0

# Rate limiting
SCRAPER_REQUESTS_PER_SECOND=10
SCRAPER_BURST_SIZE=20
SCRAPER_RESPECT_ROBOTS_TXT=true

# Processing
SCRAPER_ENABLE_JAVASCRIPT_RENDERING=false
SCRAPER_BROWSER_TIMEOUT=30000
SCRAPER_MAX_PAGE_SIZE=10485760  # 10MB

# Caching
CACHE_ENABLED=true
CACHE_TTL=3600  # 1 hour

# Logging
BACKEND_LOG_LEVEL=INFO  # DEBUG|INFO|WARNING|ERROR|CRITICAL
STRUCTURED_LOGGING=true

# Security
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

#==============================================================================
# FRONTEND CONFIGURATION (React/TypeScript)
#==============================================================================

# Server settings
FRONTEND_PORT=3000
FRONTEND_HOST=0.0.0.0

# API Configuration
FRONTEND_API_URL=http://backend:8000
FRONTEND_API_TIMEOUT=30000

# Features
FRONTEND_ENABLE_MONITORING=true
FRONTEND_ENABLE_CACHE=true
FRONTEND_MAX_CONCURRENT_JOBS=5

# UI Settings
FRONTEND_THEME=light  # light|dark|auto
FRONTEND_RESULTS_PER_PAGE=20

#==============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
#==============================================================================

# Connection settings
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=csfrace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_password_change_in_production

# Pool settings
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=30
POSTGRES_POOL_TIMEOUT=30

# Development settings
POSTGRES_ECHO_SQL=false  # Set to true for SQL query logging

#==============================================================================
# REDIS CONFIGURATION (Caching & Sessions)
#==============================================================================

# Connection
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Full URL (alternative to individual settings)
REDIS_URL=redis://redis:6379/0

# Connection pool
REDIS_MAX_CONNECTIONS=20
REDIS_RETRY_ON_TIMEOUT=true
REDIS_SOCKET_TIMEOUT=30

#==============================================================================
# MONITORING & OBSERVABILITY
#==============================================================================

# Grafana
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_change_in_production
GRAFANA_ANONYMOUS_ACCESS=false

# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
PROMETHEUS_SCRAPE_INTERVAL=15s

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9000
HEALTH_CHECK_INTERVAL=30

# Logging
LOG_LEVEL=INFO
CENTRALIZED_LOGGING=true

#==============================================================================
# SECURITY CONFIGURATION
#==============================================================================

# Authentication (if implemented)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API Security
API_RATE_LIMIT_PER_MINUTE=100
API_ENABLE_AUTHENTICATION=false  # Set to true in production

# Content Security
ENABLE_HTML_SANITIZATION=true
MAX_CONTENT_SIZE=52428800  # 50MB
ALLOWED_FILE_TYPES=html,htm,txt,md

# HTTPS (production)
ENABLE_HTTPS=false
SSL_CERT_PATH=
SSL_KEY_PATH=

#==============================================================================
# DEVELOPMENT SETTINGS
#==============================================================================

# Debug settings (development only)
DEBUG=true
RELOAD_ON_CHANGE=true
ENABLE_PROFILING=false

# Testing
TEST_DATABASE_URL=postgresql://postgres:postgres@postgres-test:5432/test_db
PYTEST_TIMEOUT=300

# Development tools
ENABLE_DEBUG_TOOLBAR=true
ENABLE_INTERACTIVE_DEBUGGER=false  # Security risk - never enable in production

#==============================================================================
# PRODUCTION OVERRIDES
# Uncomment and configure for production deployment
#==============================================================================

# ENVIRONMENT=production
# DEBUG=false
# BACKEND_LOG_LEVEL=WARNING
# POSTGRES_PASSWORD=your-super-secure-database-password
# GRAFANA_ADMIN_PASSWORD=your-secure-grafana-password
# JWT_SECRET_KEY=your-production-jwt-secret-key
# ENABLE_HTTPS=true
# API_ENABLE_AUTHENTICATION=true

#==============================================================================
# DOCKER COMPOSE OVERRIDES
#==============================================================================

# Resource limits (uncomment for production)
# BACKEND_MEMORY_LIMIT=2g
# FRONTEND_MEMORY_LIMIT=1g
# POSTGRES_MEMORY_LIMIT=2g
# REDIS_MEMORY_LIMIT=512m

# Restart policies
RESTART_POLICY=unless-stopped  # no|always|on-failure|unless-stopped

#==============================================================================
# EXTERNAL INTEGRATIONS
#==============================================================================

# Webhook notifications (optional)
WEBHOOK_URL=
WEBHOOK_SECRET=

# Email notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Cloud storage (optional)
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1