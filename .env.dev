# =============================================================================
# CSFrace Scrape - Development Environment Configuration
# =============================================================================
# SOLID Principles Applied:
# - Single Responsibility: Each section handles one aspect
# - DRY: No configuration duplication
# - Open/Closed: Extensible without modifying docker-compose files
# =============================================================================

# =============================================================================
# GLOBAL CONFIGURATION
# =============================================================================
COMPOSE_PROJECT_NAME=csfrace-scrape
ENVIRONMENT=development
RESTART_POLICY=unless-stopped

# =============================================================================
# DATABASE CONFIGURATION (Single Source of Truth)
# =============================================================================
# PostgreSQL Core Settings
POSTGRES_HOST=postgres-dev
POSTGRES_PORT=5432
POSTGRES_DB=csfrace_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Derived Database URL (DRY Principle)
DATABASE_URL=postgresql://postgres:postgres@postgres-dev:5432/csfrace_dev

# =============================================================================
# REDIS CONFIGURATION (Single Source of Truth)
# =============================================================================
# Redis Core Settings
REDIS_HOST=redis-dev
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Derived Redis URL (DRY Principle)
REDIS_URL=redis://redis-dev:6379/0

# =============================================================================
# BACKEND SERVICE CONFIGURATION
# =============================================================================
BACKEND_HOST=backend
BACKEND_PORT=8000
BACKEND_DEBUG_PORT=5678
BACKEND_LOG_LEVEL=DEBUG
SECRET_KEY=development-secret-change-in-production

# Backend Service Names (for health checks)
BACKEND_REDIS_SERVICE_NAME=redis-dev
BACKEND_POSTGRES_SERVICE_NAME=postgres-dev

# Backend Performance Settings
SCRAPER_CONCURRENT_REQUESTS=5
SCRAPER_REQUEST_TIMEOUT=30
SCRAPER_MAX_RETRIES=3
CACHE_BACKEND=redis

# =============================================================================
# FRONTEND SERVICE CONFIGURATION  
# =============================================================================
FRONTEND_HOST=frontend
FRONTEND_PORT=3010
FRONTEND_API_URL=http://localhost
FRONTEND_API_TIMEOUT=30000
FRONTEND_THEME=light

# =============================================================================
# MONITORING SERVICES CONFIGURATION
# =============================================================================
# Prometheus Settings
PROMETHEUS_HOST=prometheus-dev
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=7d

# Grafana Settings
GRAFANA_HOST=grafana-dev
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3001

# =============================================================================
# CORS AND SECURITY CONFIGURATION
# =============================================================================
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3010,http://localhost:3001,http://localhost:3002

# =============================================================================
# DEVELOPMENT TOOLS CONFIGURATION
# =============================================================================
# pgAdmin Settings
PGADMIN_PORT=8080
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# Redis Commander Settings
REDIS_COMMANDER_PORT=8081
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=admin

# Mailhog Settings (Email testing)
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# =============================================================================
# RESOURCE LIMITS (Environment-Specific)
# =============================================================================
# Backend Resources
BACKEND_MEMORY_LIMIT=1g
BACKEND_CPU_LIMIT=0.5

# Frontend Resources  
FRONTEND_MEMORY_LIMIT=512m
FRONTEND_CPU_LIMIT=0.25

# Database Resources
POSTGRES_MEMORY_LIMIT=1g
POSTGRES_CPU_LIMIT=0.5

# Cache Resources
REDIS_MEMORY_LIMIT=384m
REDIS_CPU_LIMIT=0.25

# Monitoring Resources
PROMETHEUS_MEMORY_LIMIT=512m
PROMETHEUS_CPU_LIMIT=0.5
GRAFANA_MEMORY_LIMIT=512m
GRAFANA_CPU_LIMIT=0.5