{
  "name": "csfrace-scrape",
  "version": "1.0.0",
  "description": "CSFrace Scraping Application - Umbrella Repository",
  "private": true,
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:integration": "newman run tests/api-contracts/postman-collection.json -e tests/api-contracts/integration-environment.json",
    "playwright:install": "playwright install --with-deps",
    "docker:test": "docker compose -f docker-compose.test.yml up -d --wait",
    "docker:test:down": "docker compose -f docker-compose.test.yml down -v",
    "wait-for-services": "./scripts/wait-for-services.sh"
  },
  "dependencies": {
    "@playwright/test": "^1.55.0"
  },
  "devDependencies": {
    "newman": "^6.1.3",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zachatkinson/csfrace-scrape.git"
  },
  "keywords": [
    "scraping",
    "oauth",
    "fastapi",
    "astro",
    "docker",
    "integration-testing",
    "e2e-testing"
  ],
  "author": "Zach Atkinson",
  "license": "MIT"
}
