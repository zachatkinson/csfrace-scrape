# CSFrace Scrape - Production Environment Configuration
# ============================================================================
# CRITICAL: This is a PRODUCTION template - ensure all secrets are changed!
# ============================================================================

# Copy this file to .env and customize:
# cp .env.production.example .env

#==============================================================================
# ENVIRONMENT CONFIGURATION
#==============================================================================

# Environment Profile
ENVIRONMENT=production
COMPOSE_PROJECT_NAME=csfrace-scrape

# Networking
DOCKER_NETWORK=csfrace-network

#==============================================================================
# SECURITY - CRITICAL: CHANGE ALL DEFAULT VALUES!
#==============================================================================

# Application Secret Key
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE-ME-GENERATE-WITH-OPENSSL-RAND-HEX-32

# Database Password
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE-ME-USE-STRONG-PASSWORD-HERE

# Grafana Admin Password
GRAFANA_ADMIN_PASSWORD=CHANGE-ME-USE-STRONG-PASSWORD-HERE

#==============================================================================
# AUTHENTICATION & TOKENS
#==============================================================================

# JWT Configuration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720  # 12 hours

# WebAuthn/Passkeys Configuration
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=CSFrace Scrape
WEBAUTHN_ORIGIN=https://localhost

#==============================================================================
# OAUTH2 PROVIDERS (Single Sign-On Authentication)
#==============================================================================
# Configure OAuth providers to enable modern SSO authentication.
# Users can sign in with their existing Google, GitHub, Microsoft, Facebook, or Apple accounts.
#
# Benefits of OAuth SSO:
# - Professional, modern authentication experience
# - No need to remember additional passwords
# - Leverages existing trusted accounts
# - Secure OAuth 2.0 authentication flows
#
# Setup guides available in the documentation:
# - SETUP_GOOGLE_OAUTH.md
# - SETUP_GITHUB_OAUTH.md
# - SETUP_MICROSOFT_OAUTH.md
# - SETUP_FACEBOOK_OAUTH.md
# - SETUP_APPLE_OAUTH.md

# Google OAuth (https://console.cloud.google.com/apis/credentials)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# GitHub OAuth (https://github.com/settings/developers)
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Microsoft OAuth (https://portal.azure.com)
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# Facebook OAuth (https://developers.facebook.com/apps/)
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=

# Apple OAuth (https://developer.apple.com/account)
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_SECRET=

# OAuth Configuration (only if OAuth providers configured above)
OAUTH_REDIRECT_URI_BASE=https://localhost
FORCE_SECURE_COOKIES=true

#==============================================================================
# BACKEND CONFIGURATION
#==============================================================================

# Server Settings
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Logging (Production)
BACKEND_LOG_LEVEL=WARNING
LOG_LEVEL=WARNING
STRUCTURED_LOGGING=true

# Security
ENABLE_CORS=true
CORS_ORIGINS=https://localhost,http://localhost:3010

# Scraping Configuration (Production-safe)
SCRAPER_CONCURRENT_REQUESTS=10
SCRAPER_REQUEST_TIMEOUT=30
SCRAPER_MAX_RETRIES=3
SCRAPER_DELAY_BETWEEN_REQUESTS=1.0

# Rate Limiting (Production)
SCRAPER_REQUESTS_PER_SECOND=10
SCRAPER_BURST_SIZE=20
API_RATE_LIMIT_PER_MINUTE=100

# Caching
CACHE_ENABLED=true
CACHE_TTL=3600

#==============================================================================
# FRONTEND CONFIGURATION
#==============================================================================

# Server Settings
FRONTEND_PORT=3010
FRONTEND_HOST=0.0.0.0

# API URLs (via nginx reverse proxy)
PUBLIC_API_BASE_URL=https://localhost
SERVER_API_BASE_URL=https://localhost

# Features
FRONTEND_ENABLE_MONITORING=true
FRONTEND_ENABLE_CACHE=true
FRONTEND_MAX_CONCURRENT_JOBS=5

#==============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
#==============================================================================

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=csfrace
POSTGRES_USER=postgres
# POSTGRES_PASSWORD set above in SECURITY section

# Database URL (auto-generated)
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Pool Settings
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=30

#==============================================================================
# REDIS CONFIGURATION
#==============================================================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# Connection Pool
REDIS_MAX_CONNECTIONS=20

#==============================================================================
# MONITORING
#==============================================================================

# Grafana (http://localhost:3001)
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD set above in SECURITY section
GRAFANA_ANONYMOUS_ACCESS=false

# Prometheus (http://localhost:9090)
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d

# Metrics
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=30

#==============================================================================
# PRODUCTION SETTINGS
#==============================================================================

# Debug (DISABLED for production)
DEBUG=false
ENABLE_DEBUG_TOOLBAR=false
ENABLE_INTERACTIVE_DEBUGGER=false
RELOAD_ON_CHANGE=false

# Content Security
ENABLE_HTML_SANITIZATION=true
MAX_CONTENT_SIZE=52428800  # 50MB

#==============================================================================
# DOCKER RESOURCE LIMITS (Production-optimized)
#==============================================================================

BACKEND_MEMORY_LIMIT=2g
FRONTEND_MEMORY_LIMIT=1g
POSTGRES_MEMORY_LIMIT=2g
REDIS_MEMORY_LIMIT=768m
GRAFANA_MEMORY_LIMIT=1g

# Restart Policy
RESTART_POLICY=unless-stopped

#==============================================================================
# OPTIONAL INTEGRATIONS
#==============================================================================

# Webhook Notifications
WEBHOOK_URL=
WEBHOOK_SECRET=

# Email Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Cloud Storage (S3/compatible)
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

#==============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
#==============================================================================
#
# Before first deployment:
# [ ] Changed SECRET_KEY (openssl rand -hex 32)
# [ ] Changed POSTGRES_PASSWORD (strong password)
# [ ] Changed GRAFANA_ADMIN_PASSWORD (strong password)
# [ ] Configured OAuth providers (if needed)
# [ ] Generated SSL certificates (./scripts/generate-ssl.sh)
# [ ] Reviewed CORS_ORIGINS for your deployment URL
# [ ] Set appropriate resource limits for your hardware
# [ ] Disabled all DEBUG settings
# [ ] Set BACKEND_LOG_LEVEL to WARNING
# [ ] Configured backup script (see CLIENT_DEPLOYMENT_GUIDE.md)
#
#==============================================================================
